---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import InboxList from '../components/InboxList.astro';
import Pager from '../components/Pager.astro';
import About from '../components/About.astro';
import { SITE_URL, BLOG_ID, ORG_REF, WEBSITE_REF, SITE_DESCRIPTION, faq } from '../lib/about';
import { TAG_LABELS } from '../lib/tags';
import { getSortedThreads } from '../lib/threads';
import { sliceThreads } from '../lib/pagination';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const threads = getSortedThreads(allPosts);
const { items: pageThreads, currentPage, totalPages } = sliceThreads(threads, 1);

const description = SITE_DESCRIPTION;

const subjectOf = (latest: (typeof pageThreads)[number]['latest']) =>
  'Re: '.repeat(latest.data.replyDepth) + latest.data.subject;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    '@id': BLOG_ID,
    name: 'Последние правки',
    description: 'Юмористический проект: вымышленная рабочая почта вымышленного издательского агентства. Рассылки, письма авторов и внутренняя переписка редакции, написанные с помощью нейросети и отредактированные человеком. Все персонажи и организации выдуманы.',
    url: `${SITE_URL}/`,
    inLanguage: 'ru-RU',
    genre: ['юмор', 'вымышленная переписка', 'эпистолярная проза'],
    isAccessibleForFree: true,
    isPartOf: WEBSITE_REF,
    publisher: ORG_REF,
    author: ORG_REF,
    hasPart: (['rassylka', 'avtory', 'perepiska', 'poslednie-pravki'] as const).map((tag) => ({
      '@type': 'CollectionPage',
      name: `Папка: ${TAG_LABELS[tag]}`,
      url: `${SITE_URL}/tag/${tag}/`,
    })),
    blogPost: pageThreads.map(({ base, latest }) => ({
      '@type': 'BlogPosting',
      headline: subjectOf(latest),
      url: `${SITE_URL}/letter/${base}/`,
      datePublished: latest.data.date.toISOString(),
      articleSection: TAG_LABELS[latest.data.tag] ?? latest.data.tag,
      inLanguage: 'ru-RU',
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
];
---
<Base description={description} schema={schema}>
  <About />
  <InboxList threads={pageThreads} emptyMessage="Пока пусто. Первые письма скоро появятся." />
  <Pager currentPage={currentPage} totalPages={totalPages} baseUrl="/" />
</Base>
