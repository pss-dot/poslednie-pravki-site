---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import InboxList from '../../components/InboxList.astro';
import Pager from '../../components/Pager.astro';
import { getSortedThreads } from '../../lib/threads';
import { sliceThreads } from '../../lib/pagination';
import { TAG_LABELS, TAG_SLUGS } from '../../lib/tags';
import { SITE_URL, BLOG_REF, ORG_REF } from '../../lib/about';

export async function getStaticPaths() {
  return TAG_SLUGS.map((tag) => ({ params: { tag } }));
}

const { tag } = Astro.params;
const allPosts = await getCollection('posts', ({ data }) => !data.draft && data.tag === tag);
const threads = getSortedThreads(allPosts);
const { items: pageThreads, currentPage, totalPages } = sliceThreads(threads, 1);

const tagLabel = TAG_LABELS[tag] ?? tag;
const description = `Папка «${tagLabel}» в вымышленной рабочей почте издательского агентства «Последние правки» — юмористический проект, письма пишутся с помощью нейросети.`;
const canonicalURL = new URL(`/tag/${tag}/`, 'https://poslednie-pravki.ru').toString();
const baseUrl = `/tag/${tag}/`;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    '@id': `${canonicalURL}#collection`,
    name: `Папка: ${tagLabel}`,
    description,
    url: canonicalURL,
    inLanguage: 'ru-RU',
    isPartOf: BLOG_REF,
    publisher: ORG_REF,
    breadcrumb: { '@id': `${canonicalURL}#breadcrumb` },
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: pageThreads.map(({ base, latest }, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: new URL(`/letter/${base}/`, SITE_URL).toString(),
        name: 'Re: '.repeat(latest.data.replyDepth) + latest.data.subject,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    '@id': `${canonicalURL}#breadcrumb`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Все письма', item: `${SITE_URL}/` },
      { '@type': 'ListItem', position: 2, name: tagLabel, item: canonicalURL },
    ],
  },
];
---
<Base title={`Папка: ${tagLabel}`} description={description} schema={schema}>
  <InboxList threads={pageThreads} emptyMessage="В этой папке пока пусто." />
  <Pager currentPage={currentPage} totalPages={totalPages} baseUrl={baseUrl} />
</Base>
