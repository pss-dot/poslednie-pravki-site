---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import InboxList from '../../components/InboxList.astro';
import Pager from '../../components/Pager.astro';
import { getSortedThreads } from '../../lib/threads';
import { PAGE_SIZE } from '../../lib/pagination';

export async function getStaticPaths({ paginate }) {
  const allPosts = await getCollection('posts', ({ data }) => !data.draft);
  const threads = getSortedThreads(allPosts);
  // Page 1 lives at "/" (see src/pages/index.astro) — drop it here so we
  // don't generate a duplicate page at "/page/1/".
  return paginate(threads, { pageSize: PAGE_SIZE }).slice(1);
}

const { page } = Astro.props;
const description = 'Всё, что приходит на почту издательского агентства «Последние правки»: рассылки, рукописи и внутренняя переписка.';
---
<Base title={`Все письма — стр. ${page.currentPage}`} description={description}>
  <InboxList threads={page.data} />
  <Pager currentPage={page.currentPage} totalPages={page.lastPage} baseUrl="/" />
</Base>
