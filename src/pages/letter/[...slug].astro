---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { groupThreads } from '../../lib/threads';
import { TAG_LABELS } from '../../lib/tags';
import { SITE_URL, ORG_REF, BLOG_REF, DISCLAIMER } from '../../lib/about';
import relatedMap from '../../data/related.json';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  const threads = groupThreads(posts);

  // Chronological order (oldest first) so "previous/next letter" navigation
  // reads the same direction as scrolling through a real inbox over time.
  const ordered = Array.from(threads.entries()).map(([base, members]) => ({
    base,
    members,
    latest: members[members.length - 1],
  }));
  ordered.sort((a, b) => a.latest.data.date.valueOf() - b.latest.data.date.valueOf());

  const subjectOf = (t: (typeof ordered)[number]) =>
    'Re: '.repeat(t.latest.data.replyDepth) + t.latest.data.subject;

  const bySlug = new Map(ordered.map((t) => [t.base, t]));

  return ordered.map(({ base, members }, i) => {
    const prev = i > 0 ? ordered[i - 1] : null;
    const next = i < ordered.length - 1 ? ordered[i + 1] : null;

    // «Читайте также»: сначала вручную подобранные связи (src/data/related.json),
    // затем добираем до четырёх ближайшими по дате письмами из той же папки.
    const picked: string[] = [];
    for (const slug of ((relatedMap as Record<string, string[]>)[base] ?? [])) {
      if (slug !== base && bySlug.has(slug) && !picked.includes(slug)) picked.push(slug);
    }
    const tag = members[0].data.tag;
    const sameTag = ordered
      .map((t, idx) => ({ t, dist: Math.abs(idx - i) }))
      .filter(({ t }) => t.base !== base && t.members[0].data.tag === tag && !picked.includes(t.base))
      .sort((a, b) => a.dist - b.dist);
    for (const { t } of sameTag) {
      if (picked.length >= 4) break;
      picked.push(t.base);
    }
    const related = picked.slice(0, 4).map((slug) => ({ base: slug, subject: bySlug.get(slug)!.members[0].data.subject }));

    return {
      params: { slug: base },
      props: {
        members,
        prevLetter: prev ? { base: prev.base, subject: subjectOf(prev) } : null,
        nextLetter: next ? { base: next.base, subject: subjectOf(next) } : null,
        related,
      },
    };
  });
}

const { members, prevLetter, nextLetter, related } = Astro.props;
const latest = members[members.length - 1];
const isThread = members.length > 1;

const items = await Promise.all(
  members.map(async (post, i) => {
    const { Content } = await render(post);
    return { post, Content, isFirst: i === 0 };
  })
);

const dateFmt = new Intl.DateTimeFormat('ru-RU', {
  day: 'numeric', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit',
});
const dateFmtShort = new Intl.DateTimeFormat('ru-RU', {
  day: 'numeric', month: 'long', year: 'numeric',
});

const SingleContent = items[0].Content;
const displaySubject = 'Re: '.repeat(latest.data.replyDepth) + latest.data.subject;

// Plain-text excerpt for <meta description> and the schema.org description —
// strip quoted reply lines and markdown syntax. Decorative HTML blocks that
// carry no sentence of their own (voice-note player, broken-attachment icon)
// are dropped entirely rather than tag-stripped, so a voice message or a
// failed-upload block never becomes the excerpt just because it happens to
// sit first in the letter — any other HTML (chat screenshots, forwarded
// quotes, etc.) has its tags stripped but its text kept.
const excerpt = latest.body
  ? latest.body
      .split('\n')
      .filter((line) => !line.trim().startsWith('>'))
      .join(' ')
      .replace(/<div class="voice-note">[\s\S]*?<\/div>/g, '')
      .replace(/<div class="attachment-broken">[\s\S]*?<\/div>/g, '')
      .replace(/<[^>]+>/g, ' ')
      .replace(/[#*_`>]/g, '')
      .replace(/\s+/g, ' ')
      .trim()
  : '';
// Описание для <meta> и schema.org: до ~155 символов, обрезаем по границе слова.
const excerptShort = (() => {
  if (excerpt.length <= 155) return excerpt;
  const cut = excerpt.slice(0, 155);
  const lastSpace = cut.lastIndexOf(' ');
  const base = (lastSpace > 100 ? cut.slice(0, lastSpace) : cut).replace(/[\s,;:—–-]+$/, '');
  return base.replace(/[.!?…]+$/, '') + '…';
})();

const authorName = latest.data.from.replace(/<.*?>/, '').trim();
const canonicalURL = new URL(`/letter/${members[0].id}/`, Astro.site).toString();
const ogImageURL = new URL('/og-image.png', Astro.site).toString();
const tagLabel = TAG_LABELS[latest.data.tag] ?? latest.data.tag;
const publishedTime = members[0].data.date.toISOString();
const modifiedTime = latest.data.date.toISOString();

// Чистый текст всех писем цепочки (без цитат «>» и разметки) — для articleBody и подсчёта слов.
const plainText = members
  .map((m) =>
    (m.body ?? '')
      .split('\n')
      .filter((line) => !line.trim().startsWith('>'))
      .join('\n')
      .replace(/<[^>]+>/g, ' ')
      .replace(/[#*_`]/g, '')
      .replace(/[ \t]+/g, ' ')
      .replace(/\n{3,}/g, '\n\n')
      .trim()
  )
  .join('\n\n');
const wordCount = plainText.split(/\s+/).filter(Boolean).length;
const readMinutes = Math.max(1, Math.round(wordCount / 180));

const breadcrumbId = `${canonicalURL}#breadcrumb`;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    '@id': `${canonicalURL}#article`,
    headline: displaySubject,
    description: excerptShort,
    disambiguatingDescription: DISCLAIMER,
    image: { '@type': 'ImageObject', url: ogImageURL, width: 1200, height: 630 },
    datePublished: publishedTime,
    dateModified: modifiedTime,
    url: canonicalURL,
    mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL },
    articleSection: tagLabel,
    genre: [tagLabel, 'вымышленная переписка', 'эпистолярная проза'],
    keywords: [tagLabel, 'вымышленная переписка', 'эпистолярная проза', 'издательство'].join(', '),
    inLanguage: 'ru-RU',
    isAccessibleForFree: true,
    wordCount,
    timeRequired: `PT${readMinutes}M`,
    articleBody: plainText.slice(0, 20000),
    isPartOf: BLOG_REF,
    // Отправитель письма — вымышленный персонаж, поэтому автор — сам проект.
    author: ORG_REF,
    publisher: { ...ORG_REF, logo: { '@type': 'ImageObject', url: new URL('/icon-512.png', Astro.site).toString() } },
    breadcrumb: { '@id': breadcrumbId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    '@id': breadcrumbId,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Все письма', item: `${SITE_URL}/` },
      { '@type': 'ListItem', position: 2, name: tagLabel, item: `${SITE_URL}/tag/${latest.data.tag}/` },
      { '@type': 'ListItem', position: 3, name: displaySubject, item: canonicalURL },
    ],
  },
];
---
<Base
  title={displaySubject}
  description={excerptShort}
  schema={schema}
  letterBase={members[0].id}
  ogType="article"
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
  articleAuthor={authorName}
  articleSection={tagLabel}
>
  <a class="back-link" href="/">&larr; Ко всем письмам</a>
  <article class="letter">
    <h2 class="letter-subject">{displaySubject}</h2>
    <div class="letter-topline">
      <span class="tag-badge" data-tag={latest.data.tag}>{TAG_LABELS[latest.data.tag] ?? latest.data.tag}</span>
      {isThread && <span class="thread-count">{members.length} писем в переписке</span>}
    </div>

    {isThread ? (
      <div class="thread-messages">
        {items.map(({ post, Content, isFirst }) => (
          <details class="message" open={isFirst}>
            <summary>
              <span class="msg-from">{post.data.from}</span>
              <span class="msg-date">{dateFmtShort.format(post.data.date)}</span>
            </summary>
            <div class="meta">
              <div><span class="label">От:</span> {post.data.from}</div>
              <div><span class="label">Кому:</span> {post.data.to}</div>
              <div><span class="label">Дата:</span> {dateFmt.format(post.data.date)}</div>
            </div>
            <div class="body">
              <Content />
            </div>
          </details>
        ))}
      </div>
    ) : (
      <>
        <div class="meta">
          <div><span class="label">От:</span> {latest.data.from}</div>
          <div><span class="label">Кому:</span> {latest.data.to}</div>
          <div><span class="label">Дата:</span> {dateFmt.format(latest.data.date)}</div>
        </div>
        <div class="body">
          <SingleContent />
        </div>
      </>
    )}

    <div class="share-wrap">
      <button type="button" class="share-btn" data-share-title={displaySubject}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 3 21 3 21 9"></polyline>
          <line x1="10" y1="14" x2="21" y2="3"></line>
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
        </svg>
        <span class="share-label">Переслать</span>
      </button>
    </div>
  </article>

  {related.length > 0 && (
    <aside class="related-letters" aria-labelledby="related-title">
      <h3 id="related-title">Читайте также</h3>
      <ul>
        {related.map((r) => (
          <li><a href={`/letter/${r.base}/`}>{r.subject}</a></li>
        ))}
      </ul>
    </aside>
  )}

  {(prevLetter || nextLetter) && (
    <nav class="letter-nav">
      {prevLetter ? (
        <a class="letter-nav-link prev" href={`/letter/${prevLetter.base}/`}>
          <span class="arrow">&larr;</span>
          <span class="letter-nav-text">
            <span class="letter-nav-label">Предыдущее письмо</span>
            <span class="letter-nav-subject">{prevLetter.subject}</span>
          </span>
        </a>
      ) : <span class="letter-nav-link disabled" />}
      {nextLetter ? (
        <a class="letter-nav-link next" href={`/letter/${nextLetter.base}/`}>
          <span class="letter-nav-text">
            <span class="letter-nav-label">Следующее письмо</span>
            <span class="letter-nav-subject">{nextLetter.subject}</span>
          </span>
          <span class="arrow">&rarr;</span>
        </a>
      ) : <span class="letter-nav-link disabled" />}
    </nav>
  )}
</Base>

<script>
  document.querySelectorAll('.share-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const url = window.location.href;
      const title = btn.getAttribute('data-share-title') || document.title;
      const label = btn.querySelector('.share-label');
      const originalText = label ? label.textContent : '';

      if (navigator.share) {
        try {
          await navigator.share({ url, title });
          return;
        } catch (err) {
          // user cancelled or share failed — fall through to clipboard
        }
      }

      if (navigator.clipboard) {
        try {
          await navigator.clipboard.writeText(url);
          btn.classList.add('copied');
          if (label) label.textContent = 'Ссылка скопирована';
          setTimeout(() => {
            btn.classList.remove('copied');
            if (label) label.textContent = originalText;
          }, 2000);
        } catch (err) {
          // clipboard unavailable — nothing more we can do quietly
        }
      }
    });
  });

  // Auto-expand thread messages as the reader scrolls to them, so a long
  // reply chain reads like scrolling through real correspondence instead of
  // requiring a click on every message.
  const threadMessages = document.querySelectorAll('.thread-messages .message');
  if (threadMessages.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.open = true;
          }
        });
      },
      { rootMargin: '0px 0px -15% 0px', threshold: 0 }
    );
    threadMessages.forEach((msg) => observer.observe(msg));
  }
</script>
